nextflow_process {

    name "Test Process SCANPY_EXPORT_MARKERS"
    script "../main.nf"
    process "SCANPY_EXPORT_MARKERS"

    tag "modules"
    tag "modules_local"
    tag "scanpy_export_markers"

    test("homo_sapiens - h5ad - wilcoxon") {

        setup {
            run("SCANPY_PCA") {
                script "../../pca/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                    input[1] = 50      // n_pcs
                    input[2] = false   // use_highly_variable
                    input[3] = 'X_pca' // key_added
                    input[4] = true    // write_adata
                    """
                }
            }
            run("SCANPY_NEIGHBORS") {
                script "../../neighbors/main.nf"
                process {
                    """
                    input[0] = SCANPY_PCA.out.adata
                    input[1] = 15      // n_neighbors
                    input[2] = 50      // n_pcs
                    input[3] = 'X_pca' // use_rep
                    input[4] = true    // write_adata
                    """
                }
            }
            run("SCANPY_LEIDEN") {
                script "../../leiden/main.nf"
                process {
                    """
                    input[0] = SCANPY_NEIGHBORS.out.adata
                    input[1] = 1.0        // resolution
                    input[2] = 'clusters' // key_added
                    input[3] = true       // write_adata
                    """
                }
            }
            run("SCANPY_RANK_GENES_GROUPS") {
                script "../../rank_genes_groups/main.nf"
                process {
                    """
                    input[0] = SCANPY_LEIDEN.out.adata
                    input[1] = 'clusters' // groupby
                    input[2] = 'wilcoxon' // method
                    input[3] = true       // write_adata
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SCANPY_RANK_GENES_GROUPS.out.adata
                input[1] = 0.05 // thr_adj_pvalue
                input[2] = 100  // n_top
                input[3] = 0.1  // pct_nz_group
                input[4] = 0    // min_logfc
                input[5] = '--' // sep
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    process.out.json.collect { _, path -> file(path).name }
                ).match() }
            )
        }
    }

    test("homo_sapiens - h5ad - no rank_genes_groups") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                ]
                input[1] = 0.05 // thr_adj_pvalue
                input[2] = 100  // n_top
                input[3] = 0.1  // pct_nz_group
                input[4] = 0    // min_logfc
                input[5] = '--' // sep
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    process.out.json.collect { _, path -> file(path).name }
                ).match() }
            )
        }
    }

    test("homo_sapiens - h5ad - should fail with empty separator") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                ]
                input[1] = 0.05 // thr_adj_pvalue
                input[2] = 100  // n_top
                input[3] = 0.1  // pct_nz_group
                input[4] = 0    // min_logfc
                input[5] = ''   // sep
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("The set id separator (--markers_sep) must not be empty") }
            )
        }
    }

    test("homo_sapiens - h5ad - stub") {

        options "-stub"

        setup {
            run("SCANPY_PCA") {
                script "../../pca/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                    input[1] = 50      // n_pcs
                    input[2] = false   // use_highly_variable
                    input[3] = 'X_pca' // key_added
                    input[4] = true    // write_adata
                    """
                }
            }
            run("SCANPY_NEIGHBORS") {
                script "../../neighbors/main.nf"
                process {
                    """
                    input[0] = SCANPY_PCA.out.adata
                    input[1] = 15      // n_neighbors
                    input[2] = 50      // n_pcs
                    input[3] = 'X_pca' // use_rep
                    input[4] = true    // write_adata
                    """
                }
            }
            run("SCANPY_LEIDEN") {
                script "../../leiden/main.nf"
                process {
                    """
                    input[0] = SCANPY_NEIGHBORS.out.adata
                    input[1] = 1.0        // resolution
                    input[2] = 'clusters' // key_added
                    input[3] = true       // write_adata
                    """
                }
            }
            run("SCANPY_RANK_GENES_GROUPS") {
                script "../../rank_genes_groups/main.nf"
                process {
                    """
                    input[0] = SCANPY_LEIDEN.out.adata
                    input[1] = 'clusters' // groupby
                    input[2] = 'wilcoxon' // method
                    input[3] = true       // write_adata
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SCANPY_RANK_GENES_GROUPS.out.adata
                input[1] = 0.05 // thr_adj_pvalue
                input[2] = 100  // n_top
                input[3] = 0.1  // pct_nz_group
                input[4] = 0    // min_logfc
                input[5] = '--' // sep
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
